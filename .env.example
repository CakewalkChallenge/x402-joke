# ---- server ----
# Stellar account that receives payments (public key, G...)
ADDRESS=GYourReceivingAccount

# ---- client ----
# Stellar secret key of the account that pays (S...). Must have a USDC trustline
# and hold test USDC on the network below.
PRIVATE_KEY=SYourSecretKey

# ---- shared ----
# CAIP-2 network id. stellar:testnet = Stellar testnet (use stellar:pubnet for mainnet)
NETWORK=stellar:testnet
# Facilitator that verifies + settles payments (supports stellar:testnet)
FACILITATOR_URL=https://x402.org/facilitator
# Price per /joke call, in USD -> settled in Circle USDC
PRICE=$0.001

# PORT=4021
# RESOURCE_URL=http://localhost:4021/joke
